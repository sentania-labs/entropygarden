# Entropy Garden — environment variables
# cp .env.example .env  — .env is gitignored, never commit it.

# --- Dev proxy ports (docker-compose.yml only) ---
HTTP_PORT=8080
HTTPS_PORT=8443

# --- SSL ---
# CN used when generating a self-signed certificate.
# Set to your hostname or IP for LAN access (e.g. 192.168.1.x or myserver.local)
SSL_CN=localhost

# --- Server ---
# CORS_ORIGINS is permissive by default in dev; ignored when using the proxy (same-origin).
# CORS_ORIGINS=http://localhost:5173

# --- Client ---
# Leave empty to use same-origin calls through the proxy.
# Set to http://host:8000 only if hitting the API directly without the proxy.
# VITE_API_URL=

# --- LLM agent (optional) ---
# AGENT_GAME_ID=<game id from POST /games>
# AGENT_ROLE=engineer
# LLM_PROVIDER=openrouter
# OPENROUTER_API_KEY=sk-or-...
