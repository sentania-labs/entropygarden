# Entropy Garden — environment variables
# Copy to .env and adjust:  cp .env.example .env
# .env is gitignored — never commit it.

# --- Server ---
CORS_ORIGINS=http://localhost:5173

# --- Client ---
VITE_API_URL=http://localhost:8000

