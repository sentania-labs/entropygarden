# Dev runtime data — bind mount targets for docker-compose.yml
# Directories are tracked (via .gitkeep); contents are not.
local/db/*
local/client_modules/*
local/ssl/*
!local/db/.gitkeep
!local/client_modules/.gitkeep
!local/ssl/.gitkeep
